{
  "name": "aporat/push-notifications",
  "description": "PHP client for Apple Push Notification service (APNs) and Firebase Cloud Messaging (FCM): token-based auth, persistent HTTP/2, typed payloads and normalized responses",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/aporat/push-notifications",
  "keywords": [
    "apns",
    "apple",
    "android",
    "fcm",
    "firebase",
    "ios",
    "push notifications",
    "live activity",
    "php"
  ],
  "authors": [
    {
      "name": "Adar Porat",
      "email": "aporat28@gmail.com",
      "homepage": "https://github.com/aporat",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.4",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "guzzlehttp/guzzle": "^7.9 || ^8.0",
    "guzzlehttp/promises": "^2.0 || ^3.0",
    "guzzlehttp/psr7": "^2.6 || ^3.0",
    "psr/cache": "^2.0 || ^3.0",
    "psr/clock": "^1.0",
    "psr/http-message": "^2.0",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "laravel/pint": "^1.21",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^12.0 || ^13.0"
  },
  "autoload": {
    "psr-4": {
      "Aporat\\PushNotifications\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Aporat\\PushNotifications\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "preferred-install": "dist"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test-ci": "vendor/bin/phpunit --coverage-text --coverage-clover coverage.xml --log-junit junit.xml",
    "check": "vendor/bin/pint --test",
    "fix": "vendor/bin/pint",
    "analyze": "vendor/bin/phpstan analyse --memory-limit=-1"
  },
  "support": {
    "issues": "https://github.com/aporat/push-notifications/issues",
    "source": "https://github.com/aporat/push-notifications"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
